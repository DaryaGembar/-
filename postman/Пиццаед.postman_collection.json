                "exec": [
                  "pm.test('Search returns matches', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.length).to.be.greaterThan(0);",
                  "    json.forEach(item => {",
                  "        const text = (item.name + ' ' + item.description + ' ' + (item.badges || []).join(' ')).toLowerCase();",
